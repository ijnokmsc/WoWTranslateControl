<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WoWTranslateControl</AssemblyName>
    <RootNamespace>WoWTranslateControl</RootNamespace>
    <Version>2.0.0</Version>
    <Description>WoWTranslate 本地翻译服务控制台：消息过滤管线 + 术语表 + llama-server 启停 + 多 Provider</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- 测试与冒烟工具独立编译，避免被主项目递归 glob 吞掉 -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>
</Project>
