<Window x:Class="WoWTranslateControl.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="术语表管理"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="术语在发送给模型前会被替换为占位符（⟦Gn⟧），译文返回后还原为目标语术语。&#x0a;任何增删改都会使相关缓存自动失效；游戏内插件缓存需 /wt clearcache 手动清除。"
                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8" />

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,8"
                  Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                  RowBackground="Transparent" AlternatingRowBackground="#FF1B1B22"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF2A2A33"
                  Foreground="{StaticResource TextBrush}">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                    <Setter Property="Padding" Value="6,5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF2D4A5C" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50" />
                <DataGridTextColumn Header="原文 (EN)" Binding="{Binding From}" Width="*" />
                <DataGridTextColumn Header="译文 (ZH)" Binding="{Binding To}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="原文：" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="TxtFrom" Margin="4,0" VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="2" Text="译文：" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" x:Name="TxtTo" Margin="4,0" VerticalContentAlignment="Center" />
        </Grid>

        <WrapPanel Grid.Row="3">
            <!-- 不设固定宽度：按钮由内容 + Padding 撑开，中文文字不再截断 -->
            <Button x:Name="BtnAdd" Content="添加" Margin="0,0,6,0" Click="BtnAdd_Click" />
            <Button x:Name="BtnUpdate" Content="更新选中" Margin="0,0,6,0" Click="BtnUpdate_Click" />
            <Button x:Name="BtnDelete" Content="删除选中" Margin="0,0,6,0" Click="BtnDelete_Click" />
            <Button x:Name="BtnClear" Content="清空" Margin="0,0,12,0" Click="BtnClear_Click" />
            <Button x:Name="BtnImport" Content="导入 CSV" Margin="0,0,6,0" Click="BtnImport_Click" />
            <Button x:Name="BtnExport" Content="导出 CSV" Margin="0,0,6,0" Click="BtnExport_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource OkBrush}" />
        </WrapPanel>
    </Grid>
</Window>
