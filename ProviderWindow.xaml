<Window x:Class="WoWTranslateControl.ProviderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理翻译服务"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 服务列表 -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="谷歌免费与 B站免费 API 已内置；这里添加你自己的 OpenAI 兼容服务："
                           VerticalAlignment="Center" />
                <Button x:Name="BtnAdd" Content="添加 OpenAI 兼容服务…" Margin="10,0,0,0"
                        Padding="8,3" Click="BtnAdd_Click" />
                <Button x:Name="BtnDelete" Content="删除选中" Margin="6,0,0,0"
                        Padding="8,3" Click="BtnDelete_Click" />
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="LstProviders" MinHeight="150"
                     Background="#FF101016" Foreground="#FFEEEEEE"
                     BorderBrush="{StaticResource BorderBrush}" Padding="4"
                     SelectionChanged="LstProviders_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Foreground" Value="#FFEEEEEE" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                       Foreground="#FFEEEEEE" />
                            <Border Background="#FF1E2A38" CornerRadius="3"
                                    Margin="10,0,0,0" Padding="6,1">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                           Foreground="#FF7FB2E5" />
                            </Border>
                            <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                                       FontSize="11" Foreground="#FF888888"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 编辑表单 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="编辑：" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="TxtEditingName" VerticalAlignment="Center"
                               FontWeight="Bold" Text="（未选中）" />
                </StackPanel>
                <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,6"
                           Text="选中列表即载入；修改后点「保存修改」写入该条目。切换类型后请核对下方字段再保存。" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="名称：" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtName" Width="230" />
                    <TextBlock Text="   类型：" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtType" VerticalAlignment="Center"
                               Foreground="#FF7FB2E5" FontWeight="Bold" Text="OpenAI 兼容" />
                </StackPanel>
                <StackPanel x:Name="PnlOpenAi" Margin="0,8,0,0">
                    <TextBlock Text="接口地址（完整 URL，含 /v1/chat/completions）：" Style="{StaticResource Dim}" />
                    <TextBox x:Name="TxtEndpoint" Margin="0,2" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <StackPanel Width="270">
                            <TextBlock Text="API 密钥（明文本机保存）：" Style="{StaticResource Dim}" />
                            <TextBox x:Name="TxtApiKey" Margin="0,2" />
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="模型名：" Style="{StaticResource Dim}" />
                            <TextBox x:Name="TxtModel" Width="240" Margin="0,2" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="PnlGoogle" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="语言对：" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtGoogleSl" Width="110" Text="auto" />
                        <TextBlock Text=" → " VerticalAlignment="Center" />
                        <TextBox x:Name="TxtGoogleTl" Width="110" Text="zh-CN" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="BtnSaveEntry" Content="保存修改" Style="{StaticResource PrimaryBtn}"
                        Margin="0,10,0,0" Padding="14,4" HorizontalAlignment="Left"
                        Click="BtnSaveEntry_Click" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="TxtHint" VerticalAlignment="Center"
                       Style="{StaticResource Dim}" Text="" />
            <Button x:Name="BtnOk" Content="保存并关闭" Style="{StaticResource PrimaryBtn}"
                    Padding="14,4" Click="BtnOk_Click" />
        </StackPanel>
    </Grid>
</Window>
