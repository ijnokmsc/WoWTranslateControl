<Window x:Class="WoWTranslateControl.ProviderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理翻译服务"
        Width="600" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 服务列表 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="已添加的服务（在服务控制下拉列表中选择生效）："
                       VerticalAlignment="Center" />
            <Button x:Name="BtnAddFreeApi" Content="添加免费 API（B站官方）" Margin="10,0,0,0"
                    Padding="8,3" Click="BtnAddFreeApi_Click"
                    ToolTip="一键添加 bilibili Index-Translate-35B-A3B 免费翻译接口" />
            <Button x:Name="BtnAdd" Content="添加自定义…" Margin="6,0,0,0"
                    Padding="8,3" Click="BtnAdd_Click" />
            <Button x:Name="BtnDelete" Content="删除选中" Margin="6,0,0,0"
                    Padding="8,3" Click="BtnDelete_Click" />
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="LstProviders"
                 BorderBrush="{StaticResource BorderBrush}"
                 SelectionChanged="LstProviders_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TypeLabel}" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 编辑表单 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="编辑选中服务" Style="{StaticResource CardTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="名称：" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtName" Width="200" />
                    <TextBlock Text="  类型：" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbType" Width="140"
                              SelectionChanged="CmbType_SelectionChanged">
                        <ComboBoxItem Content="OpenAI 兼容" Tag="openai" />
                        <ComboBoxItem Content="谷歌免费翻译" Tag="google" />
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="PnlOpenAi" Margin="0,6,0,0">
                    <TextBlock Text="接口地址（完整 URL，含 /v1/chat/completions）：" Style="{StaticResource Dim}" />
                    <TextBox x:Name="TxtEndpoint" Margin="0,2" />
                    <TextBlock Text="API 密钥（明文保存在本机 settings.json）：" Style="{StaticResource Dim}" />
                    <TextBox x:Name="TxtApiKey" Margin="0,2" />
                    <TextBlock Text="模型名：" Style="{StaticResource Dim}" />
                    <TextBox x:Name="TxtModel" Margin="0,2" />
                </StackPanel>
                <StackPanel x:Name="PnlGoogle" Margin="0,6,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="语言对：" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtGoogleSl" Width="110" Text="auto" />
                        <TextBlock Text=" → " VerticalAlignment="Center" />
                        <TextBox x:Name="TxtGoogleTl" Width="110" Text="zh-CN" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="BtnSaveEntry" Content="保存到选中服务" Margin="0,8,0,0"
                        Padding="10,4" Click="BtnSaveEntry_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="TxtHint" VerticalAlignment="Center"
                       Style="{StaticResource Dim}" Text="" />
            <Button x:Name="BtnOk" Content="保存并关闭" Style="{StaticResource PrimaryBtn}"
                    Padding="14,4" Click="BtnOk_Click" />
        </StackPanel>
    </Grid>
</Window>
