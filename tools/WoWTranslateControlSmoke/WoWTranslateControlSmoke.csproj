<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WoWTranslateControlSmoke</AssemblyName>
    <StartupObject>WoWTranslateControlSmoke.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="WoWTranslateControl">
      <HintPath>..\..\bin\Release\net10.0-windows\WoWTranslateControl.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
